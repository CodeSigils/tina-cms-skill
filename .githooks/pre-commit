#!/bin/sh
#
# Pre-commit hook: fast structural validation before every commit.
# Enable with: git config core.hooksPath .githooks
#
# Runs the deterministic structural checker and blocks the commit when it
# reports a finding. A missing interpreter is an environment limit, not a
# finding: it is skipped with a message rather than blocking the commit.
# The commit-message policy is enforced by the companion commit-msg hook.
#
set -e

have() {
    command -v "$1" >/dev/null 2>&1
}

echo "=== pre-commit: structural check ==="
if have node; then
    node tests/check-skill.mjs
else
    echo "pre-commit: node not found; skipping structural check"
fi
